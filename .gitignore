# Perfiles locales: contienen tokens/API keys/client secrets reales, nunca se versionan
profiles.local.json

# Parametría local: contiene códigos de cuenta reales del banco, nunca se versiona
parametria.local.json

# Logs de requests/responses: contienen datos bancarios reales (cuentas, montos, DNIs), nunca se versionan
logs/

# Seguridad local: datos del servidor de Active Directory y la lista real de usuarios
# habilitados en esta instancia, nunca se versiona (la contraseña de AD nunca se guarda acá)
security.local.json

# Archivos de salida (pfout-.../pfouterror-...): contienen datos bancarios reales, nunca se versionan
files/

# Backend Node.js (alternativa a server.ps1, ver README > "Instalación en Linux"):
# dependencias instaladas, nunca se versionan (package-lock.json sí se versiona)
node/node_modules/
