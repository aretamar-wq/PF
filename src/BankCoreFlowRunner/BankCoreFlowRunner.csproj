<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BankCoreFlowRunner</RootNamespace>
    <AssemblyName>BankCoreFlowRunner</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fuerza el motor de globalización ICU propio de .NET en vez de la API NLS de
         Windows: en máquinas con "Beta: Use Unicode UTF-8 for worldwide language
         support" activado, Windows rompe la resolución de culturas como "en-US" (el
         mismo error "Cannot find non-neutral culture related to..."), incluso sin
         InvariantGlobalization. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Flows\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="profiles.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
