<Window x:Class="BankCoreFlowRunner.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil de conexión" Height="320" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Padding="4" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="URL base" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaseUrl}" Padding="4" Margin="0,0,0,10"
                 ToolTip="Ej: https://coreapi.mibanco.com/v1"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tipo de autenticación" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AuthTypeCombo" SelectedItem="{Binding AuthType}" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nombre del header (API Key)" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ApiKeyHeaderName}" Padding="4" Margin="0,0,0,10"
                 ToolTip="Solo aplica si el tipo de autenticación es 'ApiKey'. Ej: X-Api-Key"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="API Key / Token" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="TokenBox" Padding="4" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="OnCancel" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Guardar" Click="OnAccept" Padding="14,6" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
