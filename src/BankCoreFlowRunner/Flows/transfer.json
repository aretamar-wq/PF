{
  "name": "Transferencia entre cuentas",
  "description": "Ejecuta una transferencia en dos pasos: valida la operación y luego la confirma. AJUSTAR a la API real del core bancario.",
  "inputs": [
    { "variableName": "sourceAccount", "label": "Cuenta origen" },
    { "variableName": "destinationAccount", "label": "Cuenta destino" },
    { "variableName": "amount", "label": "Monto" },
    { "variableName": "currency", "label": "Moneda", "defaultValue": "ARS" }
  ],
  "steps": [
    {
      "name": "Validar transferencia",
      "method": "POST",
      "pathTemplate": "/transfers/validate",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{ \"sourceAccount\": \"{{sourceAccount}}\", \"destinationAccount\": \"{{destinationAccount}}\", \"amount\": {{amount}}, \"currency\": \"{{currency}}\" }",
      "extractVariables": {
        "transferId": "data.transferId"
      },
      "expectedStatusCode": 200
    },
    {
      "name": "Confirmar transferencia",
      "method": "POST",
      "pathTemplate": "/transfers/{{transferId}}/confirm",
      "headers": { "Accept": "application/json" },
      "extractVariables": {
        "status": "data.status"
      },
      "expectedStatusCode": 200
    }
  ]
}
