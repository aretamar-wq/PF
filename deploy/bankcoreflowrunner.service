# Unidad systemd para correr BankCoreFlowRunner como servicio en Linux.
#
# Instalación (como root):
#   1. Copiar el repo a /opt/bankcoreflowrunner (o el path que uses en ExecStart/WorkingDirectory).
#   2. useradd --system --no-create-home --shell /usr/sbin/nologin bankcoreflowrunner
#      (crea también el grupo bankcoreflowrunner por default; comando
#      portable entre Debian/Ubuntu y RHEL/CentOS/Rocky/Alma — a diferencia
#      de "adduser", que en Debian es un wrapper con otra sintaxis y en RHEL
#      ni siquiera viene instalado)
#   3. chown -R bankcoreflowrunner:bankcoreflowrunner /opt/bankcoreflowrunner
#   4. cp deploy/bankcoreflowrunner.service /etc/systemd/system/
#   5. systemctl daemon-reload && systemctl enable --now bankcoreflowrunner
#   6. journalctl -u bankcoreflowrunner -f   (para ver los mismos mensajes que Write-Host/Write-Warning)
#
# El listener de server.ps1 solo escucha en localhost:8787 (no en 0.0.0.0) —
# nginx es el único punto de entrada expuesto a la red, ver
# deploy/nginx-bankcoreflowrunner.conf.

[Unit]
Description=BankCoreFlowRunner
After=network.target

[Service]
Type=simple
User=bankcoreflowrunner
Group=bankcoreflowrunner
WorkingDirectory=/opt/bankcoreflowrunner
ExecStart=/usr/bin/pwsh -NoProfile -File /opt/bankcoreflowrunner/server.ps1 -Port 8787
Restart=on-failure
RestartSec=5

# logs/, files/ y los *.local.json quedan bajo WorkingDirectory — necesitan
# ser escribibles por este usuario (ya cubierto por el chown del paso 3).
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
