{
  "name": "Consulta de movimientos",
  "description": "Obtiene el historial de movimientos de una cuenta en un rango de fechas. AJUSTAR a la API real del core bancario.",
  "enabled": false,
  "inputs": [
    { "variableName": "accountNumber", "label": "Número de cuenta" },
    { "variableName": "dateFrom", "label": "Fecha desde (YYYY-MM-DD)" },
    { "variableName": "dateTo", "label": "Fecha hasta (YYYY-MM-DD)" }
  ],
  "steps": [
    {
      "name": "Obtener movimientos",
      "method": "GET",
      "pathTemplate": "/accounts/{{accountNumber}}/transactions?from={{dateFrom}}&to={{dateTo}}",
      "headers": { "Accept": "application/json" },
      "extractVariables": {
        "transactionCount": "data.count"
      },
      "expectedStatusCode": 200
    }
  ]
}
