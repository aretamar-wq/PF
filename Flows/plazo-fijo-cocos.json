{
  "name": "Plazo Fijo Cocos",
  "description": "Encadena 3 pasos: débito en Cuenta Corriente, crédito en Caja de Ahorro y alta de Plazo Fijo. Si un paso falla, no se ejecutan los siguientes. importe se usa como Importe en los dos movimientos y como importePactado del plazo fijo. codigoCuenta (Caja de Ahorro) se usa como cuenta acreditada del crédito y como codigoCuentaDebito/codigoCuentaAcreditacion del plazo fijo (la plata sale de ahí). numeroComprobante e idMensaje se reusan igual en los 3 pasos. codigoSistema/Transaccion/Renglon1/codigoProducto/codigoMovimiento salen de la Parametría (Cuenta Corriente, Caja de Ahorro y Plazo Fijo respectivamente).",
  "inputs": [
    { "variableName": "numeroDocumentoTitular", "label": "Número de documento del titular" },
    { "variableName": "importe", "label": "Importe" },
    { "variableName": "codigoCuentaCajaAhorro", "label": "Código de cuenta (Caja de Ahorro)" },
    { "variableName": "codigoCuentaPlazoFijo", "label": "Código de cuenta (Plazo Fijo)" },
    { "variableName": "plazo", "label": "Plazo (días)" },
    { "variableName": "numeroComprobante", "label": "Número de comprobante" },
    { "variableName": "idMensaje", "label": "IdMensaje" }
  ],
  "steps": [
    {
      "name": "1. Débito en Cuenta Corriente",
      "method": "POST",
      "pathTemplate": "/api/CuentaDebitoCredito/EjecutarCuentaDebitoCredito",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"codigoSucursal\": \"1\",\n  \"codigoSistema\": \"{{ctaCteCodigoSistema}}\",\n  \"codigoSubSistema\": \"0\",\n  \"codigoMoneda\": \"0\",\n  \"codigoCuenta\": \"{{ctaCteCodigoCuenta}}\",\n  \"NumeroOperacion\": \"1\",\n  \"Concepto\": \"17\",\n  \"SubConcepto\": \"3\",\n  \"Sistema\": \"{{ctaCteCodigoSistema}}\",\n  \"Transaccion\": \"{{ctaCteTransaccion}}\",\n  \"FechaMovimiento\": \"{{nowDate}}\",\n  \"FechayHoraMensaje\": \"{{nowDateTime}}\",\n  \"FechaNegocio\": \"{{nowDate}}\",\n  \"Importe\": \"{{importe}}\",\n  \"NumeroComprobante\": \"{{numeroComprobante}}\",\n  \"CodigoContrasiento\": \" \",\n  \"Libre\": \" \",\n  \"Renglon1\": \"{{ctaCteRenglon1}}\",\n  \"Renglon2\": \"\",\n  \"Renglon3\": \"\",\n  \"IdMensaje\": \"{{idMensaje}}\",\n  \"forzada\": \"0\"\n}",
      "extractVariables": {},
      "expectedStatusCode": 200
    },
    {
      "name": "2. Crédito en Caja de Ahorro",
      "method": "POST",
      "pathTemplate": "/api/CuentaDebitoCredito/EjecutarCuentaDebitoCredito",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"codigoSucursal\": \"1\",\n  \"codigoSistema\": \"{{cajaAhorroCodigoSistema}}\",\n  \"codigoSubSistema\": \"0\",\n  \"codigoMoneda\": \"0\",\n  \"codigoCuenta\": \"{{codigoCuentaCajaAhorro}}\",\n  \"NumeroOperacion\": \"1\",\n  \"Concepto\": \"17\",\n  \"SubConcepto\": \"3\",\n  \"Sistema\": \"{{cajaAhorroCodigoSistema}}\",\n  \"Transaccion\": \"{{cajaAhorroTransaccion}}\",\n  \"FechaMovimiento\": \"{{nowDate}}\",\n  \"FechayHoraMensaje\": \"{{nowDateTime}}\",\n  \"FechaNegocio\": \"{{nowDate}}\",\n  \"Importe\": \"{{importe}}\",\n  \"NumeroComprobante\": \"{{numeroComprobante}}\",\n  \"CodigoContrasiento\": \"C\",\n  \"Libre\": \" \",\n  \"Renglon1\": \"{{cajaAhorroRenglon1}}\",\n  \"Renglon2\": \"\",\n  \"Renglon3\": \"\",\n  \"IdMensaje\": \"{{idMensaje}}\",\n  \"forzada\": \"0\"\n}",
      "extractVariables": {},
      "expectedStatusCode": 200
    },
    {
      "name": "3. Alta de Plazo Fijo",
      "method": "POST",
      "pathTemplate": "/api/PlazoFijoCompleto/RegistrarPlazoFijoCompleto",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"codigoSucursal\": 1,\n  \"codigoMoneda\": 0,\n  \"codigoCuenta\": {{codigoCuentaPlazoFijo}},\n  \"codigoProducto\": {{plazoFijoCodigoProducto}},\n  \"importePactado\": {{importe}},\n  \"plazo\": {{plazo}},\n  \"codigoSistemaCuentaDebito\": 5,\n  \"codigoCuentaDebito\": {{codigoCuentaCajaAhorro}},\n  \"codigoSistemaAcreditacion\": 5,\n  \"codigoCuentaAcreditacion\": {{codigoCuentaCajaAhorro}},\n  \"codigoRetencionImpuesto\": 1,\n  \"tipoDocumentoTitular\": 8,\n  \"numeroDocumentoTitular\": {{numeroDocumentoTitular}},\n  \"tipoDocumentoTitular2\": null,\n  \"nroDocumentoTitular2\": null,\n  \"codigoVinculoVinc2\": null,\n  \"codigoMovimiento\": {{plazoFijoCodigoMovimiento}},\n  \"idPlantilla\": 2,\n  \"idMensaje\": \"{{idMensaje}}\"\n}",
      "extractVariables": {},
      "expectedStatusCode": 200
    }
  ]
}
