{
  "name": "Transferencia DEBIN",
  "description": "Transferencia DEBIN/CVU contra el servicio Nova-Link (POST /api/debin/cuenta/credin). Corre contra un servidor DISTINTO del resto de los flows — antes de ejecutarlo, elegí en \"Perfil\" el perfil \"Testing Nova-Link\" (ya viene en profiles.sample.json; si no existe, creá uno con \"Nuevo...\" apuntando a https://nova-link.voii.com.ar:7443), no el que uses para \"Alta de Plazo Fijos - File\". Si Nova-Link exige TLS mutuo, ese mismo perfil es donde se configuran las rutas al certificado cliente y la clave privada (ver fieldset \"Certificado cliente (TLS mutuo)\" al editar el perfil). La cuenta de débito (origen) y los valores fijos (idUsuario/concepto/moneda) salen de Parametría > \"Transferencias DEBIN\" — completarlos ahí antes de la primera transferencia real.",
  "inputs": [
    { "variableName": "creditoCuit", "label": "CUIT del destinatario (crédito)" },
    { "variableName": "creditoCbu", "label": "CBU del destinatario (crédito)" },
    { "variableName": "creditoBanco", "label": "Banco del destinatario (crédito)" },
    { "variableName": "creditoSucursal", "label": "Sucursal del destinatario (crédito)" },
    { "variableName": "creditoTitular", "label": "Titular del destinatario (crédito)" },
    { "variableName": "importe", "label": "Importe" },
    { "variableName": "idComprobante", "label": "Número de comprobante" },
    {
      "variableName": "mismoTitular",
      "label": "¿Mismo titular en origen y destino?",
      "type": "select",
      "options": [
        { "value": "0", "label": "No" },
        { "value": "1", "label": "Sí" }
      ],
      "defaultValue": "0"
    }
  ],
  "steps": [
    {
      "name": "1. Transferencia DEBIN",
      "method": "POST",
      "pathTemplate": "/api/debin/cuenta/credin",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"credito\": {\n    \"cuit\": \"{{creditoCuit}}\",\n    \"cbu\": \"{{creditoCbu}}\",\n    \"banco\": \"{{creditoBanco}}\",\n    \"sucursal\": \"{{creditoSucursal}}\",\n    \"titular\": \"{{creditoTitular}}\"\n  },\n  \"ClienteId\": \"0\",\n  \"debito\": {\n    \"cuit\": \"{{debinDebitoCuit}}\",\n    \"cbu\": \"{{debinDebitoCbu}}\",\n    \"banco\": \"{{debinDebitoBanco}}\",\n    \"sucursal\": \"{{debinDebitoSucursal}}\",\n    \"titular\": \"{{debinDebitoTitular}}\"\n  },\n  \"concepto\": \"{{debinConcepto}}\",\n  \"idUsuario\": {{debinIdUsuario}},\n  \"idComprobante\": {{idComprobante}},\n  \"moneda\": \"{{debinMoneda}}\",\n  \"importe\": {{importe}},\n  \"mismoTitular\": \"{{mismoTitular}}\",\n  \"datosGenerador\": {\n    \"ipCliente\": \"\",\n    \"tipoDispositivo\": \"\",\n    \"plataforma\": \"\",\n    \"imsi\": \"\",\n    \"imei\": \"\",\n    \"lat\": \"0\",\n    \"lng\": \"0\",\n    \"precision\": \"\"\n  }\n}",
      "extractVariables": {
        "codigoRespuesta": "params.response.respuesta.codigo",
        "descripcionRespuesta": "params.response.respuesta.descripcion",
        "idRespuesta": "params.response.respuesta.id"
      },
      "expectedStatusCode": 200
    }
  ]
}
