{
  "name": "Alta de Plazo Fijos - File",
  "description": "",
  "inputMode": "csv",
  "inputs": [
    { "variableName": "cuit", "label": "CUIT" },
    { "variableName": "apellidoNombre", "label": "Apellido y Nombre" },
    { "variableName": "importe", "label": "Monto" },
    { "variableName": "plazo", "label": "Plazo (días)" },
    { "variableName": "numeroComprobante", "label": "Nro_Comprobante" },
    { "variableName": "circuito", "label": "Circuito" }
  ],
  "steps": [
    {
      "name": "1. Débito en Cuenta Corriente",
      "method": "POST",
      "pathTemplate": "/api/CuentaDebitoCredito/EjecutarCuentaDebitoCredito",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"codigoSucursal\": \"1\",\n  \"codigoSistema\": \"{{ctaCteCodigoSistema}}\",\n  \"codigoSubSistema\": \"0\",\n  \"codigoMoneda\": \"0\",\n  \"codigoCuenta\": \"{{ctaCteCodigoCuenta}}\",\n  \"NumeroOperacion\": \"1\",\n  \"Concepto\": \"17\",\n  \"SubConcepto\": \"3\",\n  \"Sistema\": \"{{ctaCteCodigoSistema}}\",\n  \"Transaccion\": \"{{ctaCteTransaccion}}\",\n  \"FechaMovimiento\": \"{{nowDate}}\",\n  \"FechayHoraMensaje\": \"{{nowDateTime}}\",\n  \"FechaNegocio\": \"{{nowDate}}\",\n  \"Importe\": \"{{importe}}\",\n  \"NumeroComprobante\": \"{{numeroComprobante}}\",\n  \"CodigoContrasiento\": \" \",\n  \"Libre\": \" \",\n  \"Renglon1\": \"Benef.: CUIL Nro.:{{cuit}}\",\n  \"Renglon2\": \"Nom.:{{apellidoNombre}}\",\n  \"Renglon3\": \"Ref.: VAR\",\n  \"IdMensaje\": \"{{idMensajeGenerado}}\",\n  \"forzada\": \"0\"\n}",
      "extractVariables": {},
      "expectedStatusCode": 200
    },
    {
      "name": "2. Crédito en Caja de Ahorro",
      "method": "POST",
      "pathTemplate": "/api/CuentaDebitoCredito/EjecutarCuentaDebitoCredito",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"codigoSucursal\": \"1\",\n  \"codigoSistema\": \"{{cajaAhorroCodigoSistema}}\",\n  \"codigoSubSistema\": \"0\",\n  \"codigoMoneda\": \"0\",\n  \"codigoCuenta\": \"{{cuecodSistema5}}\",\n  \"NumeroOperacion\": \"1\",\n  \"Concepto\": \"17\",\n  \"SubConcepto\": \"3\",\n  \"Sistema\": \"{{cajaAhorroCodigoSistema}}\",\n  \"Transaccion\": \"{{cajaAhorroTransaccion}}\",\n  \"FechaMovimiento\": \"{{nowDate}}\",\n  \"FechayHoraMensaje\": \"{{nowDateTime}}\",\n  \"FechaNegocio\": \"{{nowDate}}\",\n  \"Importe\": \"{{importe}}\",\n  \"NumeroComprobante\": \"{{numeroComprobante}}\",\n  \"CodigoContrasiento\": \" \",\n  \"Libre\": \" \",\n  \"Renglon1\": \"Orig.: CUIL Nro.: 30708424478\",\n  \"Renglon2\": \"Nom.: Cocos Capital S.A.\",\n  \"Renglon3\": \"Ref: VAR\",\n  \"IdMensaje\": \"{{idMensajeGenerado}}\",\n  \"forzada\": \"0\"\n}",
      "extractVariables": {},
      "expectedStatusCode": 200
    },
    {
      "name": "3. Alta de Plazo Fijo",
      "method": "POST",
      "pathTemplate": "/api/PlazoFijoCompleto/RegistrarPlazoFijoCompleto",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"codigoSucursal\": 1,\n  \"codigoMoneda\": 0,\n  \"codigoCuenta\": {{cuecodSistema4}},\n  \"codigoProducto\": {{plazoFijoCodigoProducto}},\n  \"importePactado\": {{importe}},\n  \"plazo\": {{plazo}},\n  \"codigoSistemaCuentaDebito\": 5,\n  \"codigoCuentaDebito\": {{cuecodSistema5}},\n  \"codigoSistemaAcreditacion\": 5,\n  \"codigoCuentaAcreditacion\": {{cuecodSistema5}},\n  \"codigoRetencionImpuesto\": 1,\n  \"tipoDocumentoTitular\": 8,\n  \"numeroDocumentoTitular\": {{cuit}},\n  \"tipoDocumentoTitular2\": null,\n  \"nroDocumentoTitular2\": null,\n  \"codigoVinculoVinc2\": null,\n  \"codigoMovimiento\": {{plazoFijoCodigoMovimiento}},\n  \"idPlantilla\": 2,\n  \"idMensaje\": \"{{idMensajeGenerado}}\"\n}",
      "extractVariables": {},
      "omitIfNull": ["codigoCuenta"],
      "expectedStatusCode": 200
    }
  ]
}
