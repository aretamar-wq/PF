{
  "name": "Alta de Plazo Fijo (solo)",
  "description": "Mismo step \"3. Alta de Plazo Fijo\" de 'Alta de Plazo Fijos - File', sin los steps de débito en Cuenta Corriente ni crédito en Caja de Ahorro. No aparece en la lista de flows (\"hidden\": true): lo usa 'Alta de Plazo Fijos - File' por atrás cuando el campo Circuito de una fila del CSV viene en 1 (ver wwwroot/app.js, función runFlowFromCsv) — se puede seguir ejecutando por nombre vía /api/run aunque no se vea en la UI.",
  "hidden": true,
  "inputs": [
    { "variableName": "cuit", "label": "CUIT" },
    { "variableName": "apellidoNombre", "label": "Apellido y Nombre" },
    { "variableName": "importe", "label": "Monto" },
    { "variableName": "plazo", "label": "Plazo (días)" },
    { "variableName": "numeroComprobante", "label": "Nro_Comprobante" },
    { "variableName": "circuito", "label": "Circuito" }
  ],
  "steps": [
    {
      "name": "3. Alta de Plazo Fijo",
      "method": "POST",
      "pathTemplate": "/api/PlazoFijoCompleto/RegistrarPlazoFijoCompleto",
      "headers": { "Accept": "application/json" },
      "bodyTemplate": "{\n  \"codigoSucursal\": 1,\n  \"codigoMoneda\": 0,\n  \"codigoCuenta\": {{cuecodSistema4}},\n  \"codigoProducto\": {{plazoFijoCodigoProducto}},\n  \"importePactado\": {{importe}},\n  \"plazo\": {{plazo}},\n  \"codigoSistemaCuentaDebito\": 5,\n  \"codigoCuentaDebito\": {{cuecodSistema5}},\n  \"codigoSistemaAcreditacion\": 5,\n  \"codigoCuentaAcreditacion\": {{cuecodSistema5}},\n  \"codigoRetencionImpuesto\": 1,\n  \"tipoDocumentoTitular\": 8,\n  \"numeroDocumentoTitular\": {{cuit}},\n  \"tipoDocumentoTitular2\": null,\n  \"nroDocumentoTitular2\": null,\n  \"codigoVinculoVinc2\": null,\n  \"codigoMovimiento\": {{plazoFijoCodigoMovimiento}},\n  \"idPlantilla\": 2,\n  \"idMensaje\": \"{{idMensajeGenerado}}\"\n}",
      "extractVariables": {},
      "omitIfNull": ["codigoCuenta"],
      "expectedStatusCode": 200
    }
  ]
}
